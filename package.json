{
  "name": "pi-task-plan",
  "version": "0.1.0",
  "description": "Task planning extension for Pi",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package"],
  "files": [
    "extensions",
    "test",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types test/state.test.ts && bun test test/state-omp.test.ts test/overlay-omp.test.ts",
    "test:omp": "bun test test/state-omp.test.ts test/overlay-omp.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/task-plan/index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions/task-plan-omp/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "18.10.4",
    "@oh-my-pi/pi-ai": "18.10.4",
    "@oh-my-pi/pi-coding-agent": "18.10.4",
    "@oh-my-pi/pi-tui": "18.10.4"
  }
}
